{
  "expo": {
    "name": "Finanțe Personale",
    "slug": "finante",
    "scheme": "finante",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4E5F2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ax.finante",
      "buildNumber": "16",
      "deploymentTarget": "16.0",
      "usesIcloudStorage": true,
      "entitlements": {
        "com.apple.developer.icloud-services": ["CloudDocuments"],
        "com.apple.developer.icloud-container-identifiers": ["iCloud.com.ax.finante"],
        "com.apple.developer.ubiquity-container-identifiers": ["iCloud.com.ax.finante"]
      },
      "infoPlist": {
        "NSUbiquitousContainers": {
          "iCloud.com.ax.finante": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "Finanțe Personale",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        }
      }
    },
    "android": {
      "package": "com.ax.finante",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4E5F2E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
