{
  "name": "finante",
  "main": "expo-router/entry",
  "version": "0.4.0",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "ios:dist:sim": "bash scripts/build-sim-release.sh",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "prebuild": "expo prebuild --clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "evals:ai": "jest __tests__/evals --no-coverage",
    "build:privacy": "node --experimental-strip-types scripts/build-privacy-html.ts",
    "parse:pdf": "node --experimental-strip-types scripts/parse-real-pdf.ts",
    "knip": "knip",
    "madge": "madge --circular --extensions ts,tsx services components hooks app",
    "dep-cruise": "depcruise --validate .dependency-cruiser.cjs services components hooks app",
    "type-coverage": "type-coverage --strict --at-least 97",
    "check": "npm run lint && npm run type-check && npm run type-coverage && npm test -- --coverage --watchAll=false && npm run knip && npm run madge && npm run dep-cruise && npm audit --audit-level=high",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^expo-file-system/legacy$": "<rootDir>/__mocks__/expo-file-system-legacy.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|pako)"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "collectCoverageFrom": [
      "services/**/*.ts",
      "!services/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 20,
        "branches": 20,
        "functions": 20,
        "statements": 20
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@react-navigation/native": "^7.1.28",
    "expo": "~55.0.4",
    "expo-build-properties": "~55.0.13",
    "expo-clipboard": "~55.0.9",
    "expo-constants": "~55.0.7",
    "expo-crypto": "~55.0.14",
    "expo-document-picker": "~55.0.8",
    "expo-file-system": "~55.0.10",
    "expo-haptics": "~15.0.7",
    "expo-image-manipulator": "^55.0.10",
    "expo-image-picker": "~55.0.10",
    "expo-linking": "~55.0.7",
    "expo-local-authentication": "~55.0.8",
    "expo-notifications": "~55.0.10",
    "expo-router": "~55.0.3",
    "expo-secure-store": "~55.0.8",
    "expo-sharing": "~55.0.11",
    "expo-splash-screen": "~55.0.10",
    "expo-sqlite": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.4",
    "expo-system-ui": "~6.0.7",
    "pako": "^2.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-cloud-storage": "^3.0.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.11",
    "knip": "^5.88.1",
    "lint-staged": "^15.5.2",
    "madge": "^7.0.0",
    "prettier": "^3.2.5",
    "type-coverage": "^2.29.7",
    "typescript": "~5.9.2"
  },
  "private": true
}
