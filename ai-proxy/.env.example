# Cheia providerului. Secret — setează-o în Rapids ca secret, NU o comite.
# O cheie NOUĂ, dedicată Finanțe — nu cheia veche din bundle.
# (Numele MISTRAL_API_KEY / MISTRAL_URL sunt acceptate ca alias.)
AI_UPSTREAM_API_KEY=
# Implicit: https://api.mistral.ai/v1
AI_UPSTREAM_URL=

# Token partajat cu aplicația (EXPO_PUBLIC_FINANTE_AI_TOKEN). Ajunge în bundle —
# obfuscare, nu securitate. OBLIGATORIU: fără el serviciul nu pornește.
# Generează: openssl rand -hex 24
PROXY_APP_TOKEN=

# Traducere nume model: ce trimite aplicația -> ce cere providerul.
# Gol = fără traducere. Exemplu pentru Gemini:
# MODEL_MAP={"mistral-small-latest":"gemini-3.8-flash"}
MODEL_MAP=

# Câți proxy de încredere stau în fața serviciului. 0 (implicit) = ignorăm
# X-Forwarded-For, fiindcă e scris de client, și contorizăm pe adresa socket-ului.
# Pune 1 doar după ce verifici ce trimite efectiv platforma (adresa reală vine la coadă).
# TRUSTED_PROXY_HOPS=0

# Plafoane (au default-uri în config.js; setează doar ce vrei să schimbi)
# PER_DEVICE_DAILY_LIMIT=20
# PER_IP_DAILY_LIMIT=60
# GLOBAL_DAILY_LIMIT=1000
# MAX_TOKENS_CAP=4000
# MAX_BODY_BYTES=2097152
# ALLOWED_MODELS=mistral-small-latest
